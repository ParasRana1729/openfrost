# OpenFrost development environment (copy to .env and adjust as needed)
# Never commit real secrets — API keys and Telegram tokens use DPAPI in later issues.

NODE_ENV=development

# API server (apps/api)
OPENFROST_API_HOST=127.0.0.1
OPENFROST_API_PORT=3001

# Control Center (apps/web)
OPENFROST_WEB_PORT=3000
OPENFROST_API_URL=http://127.0.0.1:3001

# Telegram bot (apps/telegram) — optional for local scaffold dev
# OPENFROST_TELEGRAM_TOKEN=

# Background daemon (apps/daemon)
OPENFROST_DAEMON_POLL_MS=5000
